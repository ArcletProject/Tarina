# 存根由 tarina/trie.py 的公开 API 提取(accelerated implementation, 参照 _string_c.pyi/_lru_c.pyi 风格).

from collections.abc import Callable, Generator, Iterable, Iterator, MutableMapping
from typing import Any, Generic, Literal, Protocol, Self, TypeAlias, TypeVar, overload

_KT = TypeVar("_KT")
_VT = TypeVar("_VT")
_T = TypeVar("_T")
_V = TypeVar("_V")

_T_Copy: TypeAlias = Callable[[_T], _T]
_PathConv: TypeAlias = Callable[[tuple[str, ...]], str]
_NodeFactory: TypeAlias = Callable[[_PathConv, tuple[str, ...], Generator[Any], _V | None], Any]

class _MissingType:
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, memo: dict[int, Any]) -> Self: ...

class ShortKeyError(KeyError): ...

class Step(Protocol[_KT, _VT]):
    def __bool__(self) -> bool: ...
    def get(self, default: _VT | None = None) -> _VT | None: ...
    def set(self, value: _VT) -> None: ...
    def setdefault(self, value: _VT) -> _VT: ...
    @property
    def is_set(self) -> bool: ...
    @property
    def has_subtrie(self) -> bool: ...
    @property
    def key(self) -> _KT: ...
    @property
    def value(self) -> _VT: ...

class _NoneStep(Step[None, None]):
    def __bool__(self) -> Literal[False]: ...
    @property
    def is_set(self) -> Literal[False]: ...
    @property
    def has_subtrie(self) -> Literal[False]: ...
    @property
    def key(self) -> None: ...
    @property
    def value(self) -> None: ...

class _Step(Step[str, _V]): ...

class Trie(Generic[_V]):
    HAS_VALUE: int
    HAS_SUBTRIE: int
    __hash__: None

    def __init__(
        self,
        other: MutableMapping[str, _V] | Iterable[tuple[str, _V]] | None = None,
        /,
        **kwargs: _V,
    ) -> None: ...
    def update(
        self,
        other: MutableMapping[str, _V] | Iterable[tuple[str, _V]] | None = None,
        /,
        **kwargs: _V,
    ) -> None: ...
    def merge(self, other: Trie[_V], overwrite: bool = False) -> None: ...
    def clear(self) -> None: ...
    def copy(self, make_copy: _T_Copy[_V] = ...) -> Trie[_V]: ...
    def __copy__(self) -> Self: ...
    def __deepcopy__(self, memo: dict[int, Any]) -> Self: ...
    @classmethod
    def fromkeys(cls, keys: Iterable[str], value: Any = None) -> Trie[Any]: ...
    @overload
    def __getitem__(self, key_or_slice: str) -> _V: ...
    @overload
    def __getitem__(self, key_or_slice: slice) -> Generator[_V]: ...
    def __setitem__(self, key_or_slice: str | slice, value: _V) -> None: ...
    def __delitem__(self, key_or_slice: str | slice) -> None: ...
    def pop(self, key: str, default: _V | _MissingType = ...) -> _V: ...
    def popitem(self) -> tuple[str, _V]: ...
    def setdefault(self, key: str, default: _V | None = None) -> _V: ...
    def has_key(self, key: str) -> bool: ...
    def has_node(self, key: str) -> int: ...
    def has_subtrie(self, key: str) -> bool: ...
    def __contains__(self, key: str) -> bool: ...
    def iteritems(self, prefix: str | _MissingType = ..., shallow: bool = False) -> Generator[tuple[str, _V]]: ...
    def iterkeys(self, prefix: str | _MissingType = ..., shallow: bool = False) -> Generator[str]: ...
    def itervalues(self, prefix: str | _MissingType = ..., shallow: bool = False) -> Generator[_V]: ...
    def items(self, prefix: str | _MissingType = ..., shallow: bool = False) -> list[tuple[str, _V]]: ...
    def keys(self, prefix: str | _MissingType = ..., shallow: bool = False) -> list[str]: ...
    def values(self, prefix: str | _MissingType = ..., shallow: bool = False) -> list[_V]: ...
    def __iter__(self) -> Iterator[str]: ...
    def __len__(self) -> int: ...
    def __bool__(self) -> bool: ...
    def walk_towards(self, key: str) -> Generator[Step[str, _V]]: ...
    def prefixes(self, key: str) -> Generator[Step[str, _V]]: ...
    def shortest_prefix(self, key: str) -> Step[str, _V]: ...
    def longest_prefix(self, key: str) -> Step[str, _V]: ...
    def traverse(self, node_factory: _NodeFactory[_V], prefix: str | _MissingType = ...) -> Any: ...
    def strictly_equals(self, other: object) -> bool: ...
    def enable_sorting(self, enable: bool = True) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...

class CharTrie(Trie[_V]):
    def __init__(
        self,
        other: MutableMapping[str, _V] | Iterable[tuple[str, _V]] | None = None,
        /,
        **kwargs: _V,
    ) -> None: ...

class StringTrie(Trie[_V]):
    def __init__(
        self,
        other: MutableMapping[str, _V] | Iterable[tuple[str, _V]] | None = None,
        /,
        separator: str = "/",
        **kwargs: _V,
    ) -> None: ...
    @classmethod
    def fromkeys(cls, keys: Iterable[str], value: Any = None, separator: str = "/") -> StringTrie[Any]: ...
